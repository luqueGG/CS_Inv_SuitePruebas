# LLM provider configuration (copy to .env; never commit .env)
LLM_PROVIDER=openai          # openai | anthropic | openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=                # optional, for openai_compatible
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=120
LLM_SEED=                    # ignored if provider does not support it